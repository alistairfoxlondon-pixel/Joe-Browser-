<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Read by the runtime before the first window appears, so a syntax error here does not
       show a broken screen: the process refuses to start at all, with "side by side
       configuration is incorrect". The release build runs the binary with the selftest switch
       to prove this file still parses. Comments in this file must not contain a double hyphen;
       that is not allowed inside an XML comment and makes the whole file invalid. -->
  <configSections>
    <!-- Declared so the section below is legal. An undeclared custom section is not ignored,
         it makes every later read of configuration fail. -->
    <section name="System.Windows.Forms.ApplicationConfigurationSection"
             type="System.Windows.Forms.ApplicationConfigurationSection, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <System.Windows.Forms.ApplicationConfigurationSection>
    <!-- Keeps WinForms layout stable on monitors the app is dragged between. The embedded
         manifest asks Windows for the same thing, but only this setting makes WinForms
         rescale its own controls when the DPI changes. -->
    <add key="DpiAwareness" value="PerMonitorV2" />
    <add key="EnableWindowsFormsHighDpiAutoResizing" value="true" />
  </System.Windows.Forms.ApplicationConfigurationSection>
  <appSettings>
    <!-- Present so the selftest has a real value to read, which forces this file to be
         parsed. -->
    <add key="JoeBrowser.SelfTest" value="ok" />
  </appSettings>
</configuration>
