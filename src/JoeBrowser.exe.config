<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The runtime reads this file before any application code runs, so a syntax error here
       does not show a broken screen: the process refuses to start, with the misleading
       message "side by side configuration is incorrect". Two rules follow from that.
       Comments must not contain a double hyphen, which XML forbids inside a comment.
       And System.Windows.Forms.ApplicationConfigurationSection is a built-in section, so
       it must NOT be listed in configSections; declaring a built-in section is an error. -->
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <System.Windows.Forms.ApplicationConfigurationSection>
    <!-- Keeps WinForms layout stable when a window moves between monitors of different DPI.
         The embedded manifest asks Windows for the same awareness; this makes WinForms
         rescale its own controls as well. -->
    <add key="DpiAwareness" value="PerMonitorV2" />
    <add key="EnableWindowsFormsHighDpiAutoResizing" value="true" />
  </System.Windows.Forms.ApplicationConfigurationSection>
  <appSettings>
    <!-- Present so the selftest has a real value to read, which forces this file to be
         parsed before the check can pass. -->
    <add key="JoeBrowser.SelfTest" value="ok" />
  </appSettings>
</configuration>
