<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Every section here is one .NET itself declares. A custom section with no matching
       <configSections> entry is a parse error, not an ignored key: it throws the first time
       anything reads this file, which used to be long after the window had opened. The release
       build runs JoeBrowser.exe --selftest to prove this file still parses. -->
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- Present so --selftest has a real value to read, which is what forces the parse. -->
    <add key="JoeBrowser.SelfTest" value="ok" />
  </appSettings>
  <runtime>
    <AppContextSwitchOverrides value="Switch.System.Windows.Forms.DoNotSupportSelectAllShortcutInMultilineTextBox=false" />
  </runtime>
</configuration>
